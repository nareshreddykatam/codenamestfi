# ==========================================
# FRONTEND / PUBLIC
# ==========================================

VITE_SUPABASE_URL=https://your-project.supabase.co

VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key


# Production frontend URL
VITE_APP_URL=https://your-vercel-domain.vercel.app


# Multiplayer WebSocket server
#
# LOCAL:
# VITE_WS_URL=ws://localhost:3001
#
# PRODUCTION:
# VITE_WS_URL=wss://your-server.onrender.com

VITE_WS_URL=ws://localhost:3001


# ==========================================
# BACKEND / SERVER ONLY
# ==========================================

SUPABASE_URL=https://your-project.supabase.co

# NEVER put this behind VITE_
# NEVER commit this to GitHub
SUPABASE_SECRET_KEY=sb_secret_your-key


# ==========================================
# OPTIONAL SERVER SETTINGS
# ==========================================

PORT=3001

# During local development:
REQUIRE_SUPABASE=false

# Production should use:
# REQUIRE_SUPABASE=true

# How long persisted rooms remain eligible
# for restoration after a server restart.
ROOM_PERSISTENCE_TTL_MINUTES=1440