# Supabase Configuration (Frontend / Public)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key

# Production Application Base URL (Optional, defaults to window.location.origin)
VITE_APP_URL=https://tfi-codenames.vercel.app

# Server-Only Secret (NEVER prefix with VITE_ and NEVER expose to browser client)
# SUPABASE_SECRET_KEY=your-service-role-key
